# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pitch2plan
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pitch2plan_test

# --- Auth (Phase 1 ships a dev-only provider; see docs/ARCHITECTURE.md for the production swap) ---
AUTH_PROVIDER=dev
AUTH_SECRET=change-me-to-a-long-random-string-0000
# ALLOW_DEV_AUTH=true   # only for throwaway production demos

# --- AI ---
AI_PROVIDER=mock                 # mock | anthropic
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# --- Logging ---
LOG_LEVEL=info
DEBUG_LOG_PROMPTS=false          # development only; prompts may contain sensitive data
