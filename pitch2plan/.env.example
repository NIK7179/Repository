# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pitch2plan
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pitch2plan_test

# --- Auth (Phase 1 ships a dev-only provider; see docs/ARCHITECTURE.md for the production swap) ---
AUTH_PROVIDER=dev
AUTH_SECRET=change-me-to-a-long-random-string-0000
# ALLOW_DEV_AUTH=true   # only for throwaway production demos

# --- AI ---
AI_PROVIDER=mock                 # mock | anthropic
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# --- Discovery ---
DISCOVERY_MAX_ROUNDS=3           # standard rounds before the brief is offered (users can always ask for more)
DISCOVERY_MAX_QUESTIONS=6        # questions per round

# --- Logging ---
LOG_LEVEL=info
DEBUG_LOG_PROMPTS=false          # development only; prompts may contain sensitive data

# --- Architecture generation ---
WORKER_MODE=inline               # inline = web process also runs the job worker (dev). Use external + `npm run worker` in production.
ARCH_MAX_REPAIRS=2               # bounded repair cycle
ARCH_STALE_RUN_MS=600000         # a run with no heartbeat for this long is failed so the project is never stuck

# --- Trusted knowledge (Phase 6) ---
KNOWLEDGE_FETCHER=http           # http = fetch allow-listed official pages. fixture = labelled test pages (never in production). off = no ingestion.
ALLOW_FIXTURE_DOCS=false         # must be true for KNOWLEDGE_FETCHER=fixture; tests only
KNOWLEDGE_STALE_DAYS=30          # documentation not re-checked for this long is flagged as possibly out of date
KNOWLEDGE_REFRESH_DAYS=7         # the worker re-checks indexed sources this often
KNOWLEDGE_DIAGNOSTICS=false      # exposes /api/knowledge/status; keep off in production unless you need it
