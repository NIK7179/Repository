{
  "name": "pitch2plan",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @pitch2plan/web",
    "build": "npm run db:generate && npm run build -w @pitch2plan/web",
    "start": "npm run start -w @pitch2plan/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "npm run generate -w @pitch2plan/db",
    "db:migrate": "npm run migrate -w @pitch2plan/db",
    "db:migrate:sql": "node scripts/apply-sql-migrations.mjs",
    "db:seed": "tsx --env-file=.env scripts/seed.mts",
    "postinstall": "npm run db:generate",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "eval:discovery": "tsx --env-file=.env scripts/eval-discovery.mts",
    "worker": "npm run start -w @pitch2plan/worker",
    "eval:architecture": "tsx --env-file=.env scripts/eval-architecture.mts",
    "eval:implementation": "tsx --env-file=.env scripts/eval-implementation.mts",
    "eval:change": "tsx --env-file=.env scripts/eval-change.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "eslint": "^9.30.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}