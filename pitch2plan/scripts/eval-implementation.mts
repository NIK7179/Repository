        edges: [edge('web-api', 'web-app', 'api', 'Ask and upload', 'HTTPS', 'REQUEST_RESPONSE', 'Questions and uploads'), edge('api-storage', 'api', 'document-storage', 'Store uploads', 'HTTPS', 'REQUEST_RESPONSE', 'Documents'), edge('storage-worker', 'document-storage', 'ingestion-worker', 'Process new documents', 'HTTPS', 'EVENT', 'Upload events'), edge('worker-db', 'ingestion-worker', 'primary-database', 'Store chunks and embeddings', 'TLS', 'REQUEST_RESPONSE', 'Chunks and vectors'), edge('api-db', 'api', 'primary-database', 'Retrieve passages', 'TLS', 'REQUEST_RESPONSE', 'Passages'), edge('api-llm', 'api', 'llm', 'Generate answers', 'HTTPS', 'REQUEST_RESPONSE', 'Prompts and answers'), edge('web-idp', 'web-app', 'identity-provider', 'Sign in', 'HTTPS', 'REQUEST_RESPONSE', 'Sign-in')],
        decisions: [dec('adr-001', 'Row-level tenant isolation', 'Scope every query and every object key by company id.', 'No cross-company access.', ['api', 'primary-database', 'document-storage'], ['DRV-001'], ['REQ-003']), dec('adr-002', 'Retrieval with citations', 'Retrieve passages from pgvector and cite sources.', 'Grounded answers.', ['primary-database', 'api', 'llm'], ['DRV-002'], ['REQ-002', 'REQ-004']), dec('adr-003', 'Asynchronous ingestion', 'Extract and embed in a background worker.', 'Large files.', ['ingestion-worker', 'document-storage'], ['DRV-003'], ['REQ-001', 'REQ-006']), dec('adr-004', 'Company SSO', 'Use OIDC with the company identity provider.', 'Requirement.', ['identity-provider'], ['DRV-001'], ['REQ-005'])] } },
    tendencies: [{ label: 'document upload storage', test: (p) => mentions(p, /s3|bucket/) }, { label: 'extraction / chunking / embedding', test: (p) => mentions(p, /extract|chunk|embed/) }, { label: 'vector retrieval (pgvector)', test: (p) => mentions(p, /pgvector|vector/) }, { label: 'LLM integration with citations', test: (p) => mentions(p, /citation|cite/) }, { label: 'tenant isolation enforced and tested', test: (p) => mentions(p, /tenant|company id/) && (types(p, 'TESTING', 'VALIDATION') || mentions(p, /isolation test|cross-tenant/)) }, { label: 'deletion removes documents everywhere', test: (p) => mentions(p, /delet/) }],
    penalties: [{ label: 'Kubernetes / event streaming not in the architecture', test: (p) => mentions(p, /kubernetes|kafka|flink|spark/) }] },
  { name: 'CASE 4 — Large event-driven commerce platform', pitch: 'Orders, payments and inventory as separate services on an event bus.', expect: 'Event infrastructure, several services, scaling, observability and resilience across many components.',
