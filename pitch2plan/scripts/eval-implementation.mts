/**
 * Implementation-plan quality evaluation. Runs four reference ARCHITECTURES (already confirmed, as Phase 3 would leave them) through the REAL
 * planner -> validate -> critic -> repair pipeline and prints, for HUMAN review, every phase, task, dependency and (with --deep) the full
 * instructions, steps and validation, plus mechanical metrics.
 *
 *   AI_PROVIDER=anthropic ANTHROPIC_API_KEY=sk-ant-... npm run eval:implementation            # summary + metrics
 *   AI_PROVIDER=anthropic ANTHROPIC_API_KEY=sk-ant-... npm run eval:implementation -- --deep  # + full task text
 *
 * With the default mock provider this only smoke-tests the harness: mock output says NOTHING about quality.
 * The metrics are heuristics for comparing runs, NOT objective quality. A plan can pass every metric and still be wrong for the project.
 * The tendency checks flag things worth LOOKING at; the judgement is yours.
 */
import { writeFileSync } from 'node:fs';
import { AnthropicLLMProvider, LLMGateway, MockLLMProvider, createImplementationAi, type LLMProvider } from '@pitch2plan/ai';
import { DEFAULT_IMPL_PIPELINE_CONFIG, ImplPipelineError, runImplementationPipeline } from '@pitch2plan/domain';
import { evaluateImplementationRules, genericContentKeys, topologicalOrder, validateImplementationPlan, type ImplContext, type ImplPlanInput, type ImplementationPlan } from '@pitch2plan/schemas';

type N = ImplPlanInput['architecture']['nodes'][number]; type E = ImplPlanInput['architecture']['edges'][number]; type D = ImplPlanInput['architecture']['decisions'][number];
const node = (stableKey: string, name: string, technology: string, category: string, o: Partial<N> = {}): N => ({ stableKey, name, technology, technologySlug: stableKey, category, criticality: 'MEDIUM', deploymentModel: 'MANAGED_SERVICE', provider: 'AWS', managedService: true, purpose: `${name}.`, description: `${name} in this architecture.`, configuration: [], risks: [], alternatives: [], ...o });
const edge = (id: string, source: string, target: string, label: string, protocol: string, communicationType: string, dataDescription: string): E => ({ id, source, target, label, protocol, communicationType, dataDescription, encrypted: true });
const dec = (key: string, title: string, decision: string, rationale: string, nodeStableKeys: string[], driverCodes: string[], requirementCodes: string[]): D => ({ key, title, status: 'ACCEPTED', decision, rationale, nodeStableKeys, driverCodes, requirementCodes });
const R = (n: number, category: string, statement: string) => ({ code: `REQ-${String(n).padStart(3, '0')}`, category, statement, origin: 'USER_ANSWERED' });
const DR = (n: number, name: string, description: string, priority: string) => ({ code: `DRV-${String(n).padStart(3, '0')}`, name, description, priority });

interface Case { name: string; pitch: string; input: Omit<ImplPlanInput, 'context'>; expect: string; tendencies: Array<{ label: string; test: (p: ImplementationPlan) => boolean }>; penalties: Array<{ label: string; test: (p: ImplementationPlan) => boolean }> }
const text = (p: ImplementationPlan) => p.tasks.map((t) => `${t.title} ${t.instructions} ${t.steps.map((s) => `${s.title} ${s.instruction}`).join(' ')}`).join(' ').toLowerCase();
const types = (p: ImplementationPlan, ...t: string[]) => p.tasks.some((x) => t.includes(x.taskType));
const mentions = (p: ImplementationPlan, re: RegExp) => re.test(text(p));
const HEAVY = /kubernetes|kafka|kinesis|\bmsk\b|spark|flink|pulsar|hadoop|cassandra|airflow|rabbitmq/i;

