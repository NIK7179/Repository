      requirements: [R(1, 'TRAFFIC', '20,000 orders per hour at peak'), R(2, 'AVAILABILITY', '99.95% availability; payments must never double-charge'), R(3, 'SCALABILITY', 'Services scale independently'), R(4, 'SECURITY', 'Payment data is sensitive; PCI scope must be minimal'), R(5, 'LATENCY', 'Checkout under 500 ms at p95'), R(6, 'TEAM_CONSTRAINT', 'Four teams, each owning a service')],
      drivers: [DR(1, 'Independent scaling and ownership', 'Separate services per team', 'HIGH'), DR(2, 'Exactly-once effects for payments', 'No double charge', 'CRITICAL'), DR(3, 'Resilience', 'Survive a service failing', 'HIGH')],
      architecture: { summary: 'API gateway in front of order, payment and inventory services, communicating over Amazon MSK, with Redis caching and per-service PostgreSQL.', assumptions: [], risks: [{ text: 'Duplicate event delivery could double-charge', severity: 'HIGH', nodeStableKeys: ['payment-service'] }],
        nodes: [node('api-gateway', 'API gateway', 'Amazon API Gateway', 'API', { criticality: 'CRITICAL' }), node('order-service', 'Order service', 'ECS service', 'APPLICATION_SERVICE', { criticality: 'HIGH', managedService: false, deploymentModel: 'CONTAINER' }), node('payment-service', 'Payment service', 'ECS service', 'APPLICATION_SERVICE', { criticality: 'CRITICAL', managedService: false, deploymentModel: 'CONTAINER' }), node('inventory-service', 'Inventory service', 'ECS service', 'APPLICATION_SERVICE', { criticality: 'HIGH', managedService: false, deploymentModel: 'CONTAINER' }), node('event-bus', 'Event bus', 'Amazon MSK', 'EVENT_STREAM', { criticality: 'CRITICAL', configuration: [{ key: 'replication factor', value: '3' }] }), node('orders-db', 'Orders database', 'Amazon RDS PostgreSQL', 'DATABASE', { criticality: 'CRITICAL' }), node('inventory-cache', 'Inventory cache', 'Amazon ElastiCache Redis', 'CACHE', { criticality: 'MEDIUM' }), node('payment-provider', 'Payment provider', 'Stripe', 'EXTERNAL_SERVICE', { deploymentModel: 'EXTERNAL', provider: 'Stripe', managedService: false })],
        edges: [edge('gw-order', 'api-gateway', 'order-service', 'Checkout', 'HTTPS', 'REQUEST_RESPONSE', 'Orders'), edge('order-bus', 'order-service', 'event-bus', 'Publish OrderPlaced', 'TLS', 'EVENT', 'Order events'), edge('bus-payment', 'event-bus', 'payment-service', 'Consume OrderPlaced', 'TLS', 'EVENT', 'Order events'), edge('bus-inventory', 'event-bus', 'inventory-service', 'Reserve stock', 'TLS', 'EVENT', 'Order events'), edge('order-db', 'order-service', 'orders-db', 'Persist orders', 'TLS', 'REQUEST_RESPONSE', 'Orders'), edge('inventory-cache-edge', 'inventory-service', 'inventory-cache', 'Cache stock levels', 'TLS', 'REQUEST_RESPONSE', 'Stock levels'), edge('payment-stripe', 'payment-service', 'payment-provider', 'Charge', 'HTTPS', 'REQUEST_RESPONSE', 'Payment requests')],
        decisions: [dec('adr-001', 'Event-driven services over a durable bus', 'Services communicate through MSK events.', 'Independent scaling and failure isolation.', ['event-bus', 'order-service', 'payment-service', 'inventory-service'], ['DRV-001', 'DRV-003'], ['REQ-003', 'REQ-006']), dec('adr-002', 'Idempotent payment handling', 'Payment consumers deduplicate by order id and use idempotency keys with Stripe.', 'Duplicate delivery must not double-charge.', ['payment-service', 'payment-provider'], ['DRV-002'], ['REQ-002']), dec('adr-003', 'Cache stock levels in Redis', 'Serve reads from Redis.', 'Checkout latency.', ['inventory-cache', 'inventory-service'], ['DRV-001'], ['REQ-005']), dec('adr-004', 'Tokenised payments only', 'Never store card data; Stripe tokens only.', 'Minimise PCI scope.', ['payment-service', 'payment-provider'], ['DRV-002'], ['REQ-004'])] } },
    tendencies: [{ label: 'idempotent payment handling', test: (p) => mentions(p, /idempoten|dedup/) }, { label: 'observability across several services', test: (p) => p.tasks.filter((t) => t.taskType === 'OBSERVABILITY').length >= 3 }, { label: 'scaling / autoscaling', test: (p) => mentions(p, /autoscal|scale|scaling/) }, { label: 'resilience (retries, dead-letter, failure testing)', test: (p) => mentions(p, /dead.letter|retry|retries|failure|chaos|resilien/) }, { label: 'event infrastructure tasks (topics, replication)', test: (p) => mentions(p, /topic|replication/) }, { label: 'secrets / least privilege for the payment path', test: (p) => mentions(p, /secret|least privilege|iam/) }],
    penalties: [{ label: 'storing card data (contradicts the architecture)', test: (p) => mentions(p, /store card|card numbers? in/) }] },
];

const live = process.env.AI_PROVIDER === 'anthropic'; const deep = process.argv.includes('--deep');
const model = process.env.ANTHROPIC_MODEL ?? 'claude-sonnet-5-5';
const provider: LLMProvider = live ? new AnthropicLLMProvider({ apiKey: process.env.ANTHROPIC_API_KEY!, defaultModel: model }) : new MockLLMProvider();
const tokens = { in: 0, out: 0, calls: 0 };
const gateway = new LLMGateway({ provider, model: live ? model : 'mock-1', timeoutMs: 280_000, maxRetries: 2, onUsage: (e) => { tokens.in += e.inputTokens ?? 0; tokens.out += e.outputTokens ?? 0; tokens.calls++; } });
const ai = createImplementationAi(gateway);
const lines: string[] = []; const say = (s = '') => { console.log(s); lines.push(s); };
const pct = (n: number, d: number) => (d === 0 ? 'n/a' : `${Math.round((100 * n) / d)}% (${n}/${d})`);

say(`# Implementation evaluation (${live ? `LIVE: ${model}` : 'MOCK provider: harness smoke test only, NOT a quality evaluation'})`);
say('Metrics are heuristics for comparing runs, not objective scores. Read the plans.\n');
const summary: string[] = [];
for (const c of CASES) {
  say(`\n## ${c.name}\n> ${c.pitch}\n> Expected: ${c.expect}\n`);
  const input: ImplPlanInput = { context: { workspaceId: 'eval', projectId: 'eval', userId: 'eval' }, ...c.input };
  const a = input.architecture;
  const ctx: ImplContext = { components: a.nodes.map((n) => ({ stableKey: n.stableKey, name: n.name, technology: n.technology, technologySlug: n.technologySlug, category: n.category, criticality: n.criticality, deploymentModel: n.deploymentModel })), decisions: a.decisions.map((d) => ({ key: d.key, status: d.status, title: d.title, nodeStableKeys: d.nodeStableKeys })), requirementCodes: input.requirements.map((r) => r.code) };
  const started = Date.now(); let plan: ImplementationPlan | null = null; let repairs = 0; let failure = ''; let finalIssues: Array<{ severity: string; category: string; description: string; source: string }> = [];
  try { const r = await runImplementationPipeline(ai, { input, ctx, requirementTexts: input.requirements }, DEFAULT_IMPL_PIPELINE_CONFIG); plan = r.plan; repairs = r.repairs; finalIssues = r.issues.filter((i) => i.stage === 'FINAL'); }
  catch (e) { failure = e instanceof ImplPipelineError ? `${e.code}: ${e.message}` : `${(e as { code?: string }).code ?? 'ERROR'}: ${(e as Error).message}`; if (e instanceof ImplPipelineError) finalIssues = e.issues.filter((i) => i.stage === 'FINAL'); }
  say(`Run: ${failure ? `FAILED (${failure})` : 'succeeded'} · ${Math.round((Date.now() - started) / 1000)}s · repairs=${repairs}`);
  if (!plan) { summary.push(`${c.name}: FAILED ${failure}`); continue; }

  const structural = validateImplementationPlan(plan, ctx); const rules = evaluateImplementationRules(plan, ctx, input.requirements);
  let order = 'valid'; try { topologicalOrder(plan.tasks); } catch { order = 'CYCLE'; }
  const covered = ctx.components.filter((n) => plan!.tasks.some((t) => t.componentKeys.includes(n.stableKey)) || plan!.componentCoverage.some((x) => x.stableKey === n.stableKey));
  const accepted = ctx.decisions.filter((d) => d.status === 'ACCEPTED'); const decCovered = accepted.filter((d) => plan!.tasks.some((t) => t.decisionKeys.includes(d.key)));
  const generic = genericContentKeys(plan, ctx); const withSteps = plan.tasks.filter((t) => t.steps.length > 0);
  const m: Record<string, string> = {
    'tasks / phases': `${plan.tasks.length} tasks in ${plan.phases.length} phases (${withSteps.length} with steps)`, 'dependency order': `${order}; structural issues: ${structural.length ? structural.map((i) => i.code).join(', ') : 'none'}`,
    'architecture component coverage': pct(covered.length, ctx.components.length), 'decision coverage': pct(decCovered.length, accepted.length),
    'security coverage': `${plan.tasks.filter((t) => t.taskType === 'SECURITY').length} security tasks, ${plan.tasks.filter((t) => t.securityNotes.length).length} tasks with security notes`,
    'observability coverage': `${plan.tasks.filter((t) => t.taskType === 'OBSERVABILITY').length} observability tasks`, 'testing coverage': `${plan.tasks.filter((t) => t.taskType === 'TESTING' || t.taskType === 'VALIDATION').length} testing/validation tasks`,
    'deployment coverage': `${plan.tasks.filter((t) => t.taskType === 'DEPLOYMENT' || t.taskType === 'INFRASTRUCTURE').length} deployment/infrastructure tasks`,
    'validation-step presence': pct(plan.tasks.filter((t) => t.validationSteps.length > 0).length, plan.tasks.length), 'generic-language heuristic': generic.length ? `${generic.length} task(s) flagged: ${generic.slice(0, 5).join(', ')}` : 'none flagged',
    'remaining review findings': `CRITICAL ${finalIssues.filter((i) => i.severity === 'CRITICAL').length} · HIGH ${finalIssues.filter((i) => i.severity === 'HIGH').length} · other rule hits: ${rules.map((r) => r.code).join(', ') || 'none'}`,
  };
  say('### Metrics'); for (const [k, v] of Object.entries(m)) say(`- ${k}: ${v}`);
  say('\n### Tendency checks (things worth looking for; absence is a prompt to look, not a verdict)');
  for (const t of c.tendencies) say(`- [${t.test(plan) ? 'present' : 'ABSENT '}] ${t.label}`); for (const t of c.penalties) say(`- [${t.test(plan) ? 'FLAGGED' : 'ok     '}] ${t.label}`);
  say(`\n### Plan: ${plan.summary}`);
  for (const ph of plan.phases) {
    say(`\n#### ${ph.name} — ${ph.objective}`);
    for (const t of plan.tasks.filter((x) => x.phaseKey === ph.key)) {
      say(`- ${t.key} [${t.taskType} · ${t.effort}] ${t.title}  (after: ${t.dependsOn.join(', ') || 'nothing'}; components: ${t.componentKeys.join(', ') || 'none'}; decisions: ${t.decisionKeys.join(', ') || 'none'})`);
      if (deep) { say(`    why: ${t.whyThisTask}`); say(`    do: ${t.instructions}`); for (const [n, s] of t.steps.entries()) say(`    step ${n + 1}: ${s.title} — ${s.instruction} (expect: ${s.expectedResult})`); say(`    outcome: ${t.expectedOutcome}`); for (const v of t.validationSteps) say(`    check: ${v}`); for (const x of t.securityNotes) say(`    security: ${x}`); for (const x of t.commonProblems) say(`    issue: ${x.problem} -> ${x.resolution}`); }
    }
  }
  if (plan.componentCoverage.length) { say('\nComponents with no implementation work:'); for (const x of plan.componentCoverage) say(`- ${x.stableKey}: ${x.reason}`); }
  if (finalIssues.length) { say('\nRemaining review findings:'); for (const i of finalIssues) say(`- [${i.severity} · ${i.category} · ${i.source}] ${i.description}`); }
  summary.push(`${c.name}: ${plan.tasks.length} tasks / ${plan.phases.length} phases, component coverage ${pct(covered.length, ctx.components.length)}, decision coverage ${pct(decCovered.length, accepted.length)}, repairs ${repairs}`);
}
say('\n## Summary'); for (const s of summary) say(`- ${s}`);
say(`Model calls: ${tokens.calls} · tokens ${tokens.in} in / ${tokens.out} out`);
say('\n## HUMAN REVIEW CHECKLIST (the part that matters)');
say('1. Are the steps actually actionable? Could someone follow a task without guessing what to click or type?');
