        edges: [edge('web-api', 'web-app', 'api', 'Pages call the API', 'HTTPS', 'REQUEST_RESPONSE', 'Booking requests'), edge('api-db', 'api', 'primary-database', 'Reads and writes bookings', 'TLS', 'REQUEST_RESPONSE', 'Booking records'), edge('api-email', 'api', 'email-provider', 'Sends reminders', 'HTTPS', 'REQUEST_RESPONSE', 'Reminder emails')],
        decisions: [dec('adr-001', 'Use managed PostgreSQL', 'Use a managed PostgreSQL database.', 'Small team, no database operations.', ['primary-database'], ['DRV-001'], ['REQ-001', 'REQ-005']), dec('adr-002', 'One API, no separate services', 'Keep a single API.', 'Scale is modest.', ['api'], ['DRV-001', 'DRV-002'], ['REQ-003']), dec('adr-003', 'Use an external email provider for reminders', 'Send reminders through SendGrid.', 'Do not build email delivery.', ['email-provider', 'api'], ['DRV-002'], ['REQ-002'])] } },
